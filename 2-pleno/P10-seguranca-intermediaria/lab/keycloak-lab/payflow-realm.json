{
  "realm": "payflow",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notUsername",
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Cliente comum do PayFlow"
      },
      {
        "name": "ADMIN",
        "description": "Operador do PayFlow"
      }
    ]
  },
  "clients": [
    {
      "clientId": "payflow-web",
      "name": "PayFlow (painel e app)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:8099/callback",
        "http://localhost:8080/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "payflow-notifications",
      "name": "Serviço de notificações (máquina a máquina)",
      "enabled": true,
      "publicClient": false,
      "secret": "lab-only-notifications-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic"
      ]
    },
    {
      "clientId": "payflow-reporting",
      "name": "Relatórios (máquina a máquina, sem permissão interna)",
      "enabled": true,
      "publicClient": false,
      "secret": "lab-only-reporting-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic"
      ]
    },
    {
      "clientId": "payflow-lab-direct",
      "name": "SÓ do laboratório: senha direta para testes automatizados",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "roles",
        "profile",
        "email"
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "alice@example.com",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Silva",
      "enabled": true,
      "realmRoles": [
        "USER"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "alice-lab-pass-1",
          "temporary": false
        }
      ]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "bob@example.com",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Souza",
