@startuml
title <size:24>Application</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("Application_boundary", "Application", $tags="") {
  Container_Boundary("Application.Application_boundary", "Application", $tags="") {
    Component(Application.Application.Shared, "Shared", $techn="Module", $descr="", $tags="", $link="")
    Component(Application.Application.Account, "Account", $techn="Module", $descr="", $tags="", $link="")
    Component(Application.Application.Transfer, "Transfer", $techn="Module", $descr="", $tags="", $link="")
    Component(Application.Application.Antifraud, "Antifraud", $techn="Module", $descr="", $tags="", $link="")
    Component(Application.Application.Notification, "Notification", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(Application.Application.Antifraud, Application.Application.Shared, "depends on", $techn="", $tags="", $link="")
Rel(Application.Application.Notification, Application.Application.Transfer, "listens to", $techn="", $tags="", $link="")
Rel(Application.Application.Transfer, Application.Application.Shared, "depends on", $techn="", $tags="", $link="")
Rel(Application.Application.Transfer, Application.Application.Account, "uses", $techn="", $tags="", $link="")
Rel(Application.Application.Account, Application.Application.Shared, "depends on", $techn="", $tags="", $link="")
Rel(Application.Application.Antifraud, Application.Application.Transfer, "listens to", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml